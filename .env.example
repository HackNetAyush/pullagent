# --- Provider: "anthropic" (first-party) or "foundry" (Claude on MS Foundry) ---
CR_PROVIDER=foundry

# Microsoft Foundry
CR_AZURE_API_KEY=...
CR_AZURE_RESOURCE=your-resource-name
# ...or point at the endpoint directly instead of CR_AZURE_RESOURCE:
# CR_AZURE_BASE_URL=https://your-resource.services.ai.azure.com/anthropic/v1

# First-party Anthropic (CR_PROVIDER=anthropic)
# CR_ANTHROPIC_API_KEY=sk-ant-...

# --- Models per tier slot ----------------------------------------------------
# A bare Claude name goes to the CR_PROVIDER endpoint (on Foundry it is the
# deployment name). `provider:model` picks any provider in the registry.
# `cr models` lists every provider and model; `cr doctor -m <model>` probes one.
# CR_MODEL_SMALL=claude-sonnet-5
# CR_MODEL_STANDARD=claude-sonnet-5
# CR_MODEL_DEEP=claude-sonnet-5
# CR_MODEL_VERIFIER=claude-opus-5
# CR_MODEL_T4=gpt-6-luna                      # Azure OpenAI
# CR_MODEL_T4=groq:openai/gpt-oss-120b        # ...or any other listed model

# --- Other providers ------------------------------------------------------------
# Base URLs are fixed in code; only keys are configured. A provider without a
# key is simply unavailable until a tier routes a model to it.
# Azure OpenAI reuses CR_AZURE_API_KEY and CR_AZURE_RESOURCE unless overridden:
# CR_AZURE_OPENAI_API_KEY=
# CR_OPENAI_API_KEY=sk-...
# CR_OPENROUTER_API_KEY=sk-or-...
# CR_GROQ_API_KEY=gsk_...
# CR_NVIDIA_API_KEY=nvapi-...

# --- Customer API keys (dashboard: Models -> Your API keys) -------------------
# Encrypts the keys customers add for their own custom tiers. Required whenever
# CR_DB_URL is set; a laptop install generates one under the cache dir.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate keys to rotate: the first encrypts, all of them decrypt.
# CR_SECRETS_KEY=

# Optional tuning
# CR_T1_MAX_HUNKS=8
# CR_T3_MIN_HUNKS=40
# CR_MIN_CONFIDENCE=0.35
# CR_MAX_CONTEXT_TOKENS=25000

# --- GitHub App (`cr app serve`) --------------------------------------------
# Leave all of this blank to use the Action or the CLI instead.
#
# Easiest path: start the server behind a tunnel and open /app/setup — GitHub
# creates the App and writes these for you (~/.cache/cr/github-app.json).
#
#   cloudflared tunnel --url http://localhost:8000
#   uv run cr app serve --public-url https://<tunnel-host>

# CR_GITHUB_APP_ID=123456
# The App's name on GitHub (github.com/apps/<slug>); builds the install links.
# CR_GITHUB_APP_SLUG=pullagent
# The PEM itself (raw, \n-escaped or base64), or a path to it. Prefer the path:
# it cannot be mangled by a deployment UI that strips newlines.
# CR_GITHUB_APP_PRIVATE_KEY_PATH=/secure/path/cr.private-key.pem
# CR_GITHUB_APP_PRIVATE_KEY=

# Required. Without it every delivery is rejected — an unauthenticated webhook
# endpoint lets anyone on the internet spend your model budget.
# CR_GITHUB_WEBHOOK_SECRET=

# Behaviour
# CR_APP_INCREMENTAL=true          # on a push, review only the new commits
# CR_APP_DEBOUNCE_S=20             # collapse a burst of pushes into one review
# CR_APP_MAX_CONCURRENT_REVIEWS=2
# CR_APP_REVIEW_DRAFTS=false
# CR_APP_REVIEW_FORKS=true         # fork code is read and linted, never executed
# CR_APP_REPLY_TO_COMMENTS=true
# CR_APP_COMMAND_PREFIX=@pullagent
# CR_APP_INDEX_ON_INSTALL=true
# CR_APP_ALLOW_SETUP=true          # turn off once the App exists

# --- Deployed on Azure (see docs/DEPLOYMENT.md) ------------------------------
# Every one of these is optional. Blank means "laptop": SQLite, in-process
# queue, cache on local disk — which is exactly what `cr app serve` wants.

# Postgres instead of SQLite. Required in a container: it has no durable disk.
# CR_DB_URL=postgresql+psycopg://user:pass@host:5432/cr?sslmode=require

# A shared queue, so more than one replica can exist without two of them
# reviewing the same push.
# CR_SERVICEBUS_CONNECTION=Endpoint=sb://...;SharedAccessKeyName=...;SharedAccessKey=...
# CR_SERVICEBUS_QUEUE=cr-jobs
# What this process does: all (default), web (ingress only), worker (jobs only).
# CR_APP_ROLE=all

# Where mirrors, symbol graphs and the review cache live. Point this at a
# mounted Azure Files share in a container.
# CR_CACHE_DIR=/cache

# --- Public App: sign-in and the account allowlist ---------------------------
# On by default. Turning it off means any account that installs the App can
# spend your model budget, which is only safe while the App is private.
# CR_APP_REQUIRE_APPROVAL=true

# OAuth for dashboard sign-in. The /app/setup flow receives these from GitHub
# and stores them; set them explicitly when deploying from a secret store.
# CR_GITHUB_CLIENT_ID=Iv23li...
# CR_GITHUB_CLIENT_SECRET=

# Comma-separated logins promoted to administrator on their first sign-in.
# Without at least one, nobody can approve an account and nothing is reviewed.
# CR_ADMIN_LOGINS=your-github-login
# CR_SESSION_TTL_S=1209600
